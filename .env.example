# Copy to `.env` for local builds (`cp .env.example .env`). `.env` is git-ignored — never commit real keys.
# For EAS cloud builds, set the same variables with `eas env:create` (see README → Building the APK).

# Google Maps SDK for Android key. Required for maps in standalone Android builds (APK).
# Not needed in Expo Go or on iOS. Restrict it in Google Cloud to package com.aarn9722.taskflow.
GOOGLE_MAPS_API_KEY=

# Optional default json-server URL baked into the build, e.g. http://192.168.1.10:3000
# It can still be changed at runtime in Settings → Sync & server.
EXPO_PUBLIC_API_URL=
